OPENAI_API_KEY=
CHAT_MODEL=gpt-4.1
PLANNER_MODEL=gpt-4.1-mini
VISION_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Empty URL uses embedded Qdrant for a single local process.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=content_segments
DATA_DIR=./data
FFMPEG=ffmpeg
FFPROBE=ffprobe
# Optional audio-event analysis. Extra model calls per temporal segment.
AUDIO_EVENTS=false
AUDIO_MODEL=gpt-audio
# Optional shared-workspace access token, required for non-local deployments.
APP_TOKEN=

# Dense highlights analysis (existing sources need reindexing)
SEGMENT_SECONDS=6
VIDEO_FPS=1
FRAME_OVERLAP_SECONDS=1
TIMELINE_CONTEXT_TOKENS=100000
TIMELINE_MAX_SEGMENTS=1200

# Answer generation only. Other pipeline stages still use OPENAI_API_KEY.
CHAT_PROVIDER=azure
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
